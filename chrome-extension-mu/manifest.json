{
  "manifest_version": 3,
  "name": "Mafia Host on MafiaUniverse",
  "version": "0.2.0",
  "description": "Заменяет интерфейс /Games/Edit на mafiauniverse.org на UI приложения Mafia Host. Автокомплит игроков, ввод игры, заполнение их формы по кнопке.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://mafiauniverse.org/*", "http://mafiauniverse.org/*"],
  "action": {
    "default_title": "Mafia Host → MafiaUniverse",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mafiauniverse.org/Games/Edit*",
        "http://mafiauniverse.org/Games/Edit*"
      ],
      "js": ["mu-form-io.js", "content.js"],
      "css": ["inject.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["app/*"],
      "matches": ["https://mafiauniverse.org/*", "http://mafiauniverse.org/*"]
    }
  ]
}
